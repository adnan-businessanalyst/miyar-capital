# Miyar API (standalone backend)
PORT=4000

# Local site origin (used on this machine). Extra origins: comma-separated.
FRONTEND_ORIGIN=http://localhost:3001

# Vercel site origins. Hosted Railway picks one from APP_ENV.
# Staging Vercel (this GitHub repo). Production Vercel (TheProvenX).
VERCEL_URL_STAGING=https://your-staging.vercel.app
VERCEL_URL_PRODUCTION=https://your-production.vercel.app

# Which Neon to use: staging (default, local + staging Railway) or production.
# Hosted production: set APP_ENV=production and DATABASE_URL to that Neon.
# Local schema against production: keep both URLs and run `pnpm db:push:production`.
APP_ENV=staging

# Staging Neon (local + staging Railway). DATABASE_URL is the staging alias.
DATABASE_URL_STAGING=postgresql://user:password@staging-host/db?sslmode=require
DATABASE_URL=postgresql://user:password@staging-host/db?sslmode=require

# Production Neon (TheProvenX stack). Required for `pnpm db:*:production`.
DATABASE_URL_PRODUCTION=postgresql://user:password@production-host/db?sslmode=require

# Office 365 SMTP (STARTTLS). Fill user, password, from, and to for the client mailbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Optional aliases if MAIL_FROM / MAIL_TO are unset
CONTACT_FROM_EMAIL="Miyar Capital <noreply@your-verified-domain.com>"
CONTACT_TO_EMAIL=inbox@your-company.com

# Google reCAPTCHA v3 secret — production Railway. Leave empty on staging.
# Production always verifies (fail closed). Staging/local skip verification.
RECAPTCHA_SECRET_KEY=

# Admin control panel
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Cookie strategy:
# - Default (recommended): front the API behind a same-origin reverse proxy
#   (Next.js / Vercel rewrite /api → this API). Use SameSite=Lax (default).
# - Cross-origin admin without proxy: set COOKIE_SAME_SITE=none (requires HTTPS).
COOKIE_SAME_SITE=lax
