{
  "name": "@workspace/miyar-capital",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/generate-media-manifest.mjs",
    "prebuild": "node ./scripts/generate-media-manifest.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "media:manifest": "node ./scripts/generate-media-manifest.mjs",
    "media:optimize": "node ./scripts/optimize-media.mjs && node ./scripts/post-optimize-hero.mjs && node ./scripts/generate-media-manifest.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "lucide-react": "catalog:",
    "next": "^15.5.2",
    "postgres": "^3.4.7",
    "react": "catalog:",
    "react-dom": "catalog:",
    "resend": "^6.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.4",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3"
  }
}
