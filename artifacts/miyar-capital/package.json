  "scripts": {
    "predev": "node ./scripts/generate-media-manifest.mjs",
    "prebuild": "node ./scripts/generate-media-manifest.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "media:manifest": "node ./scripts/generate-media-manifest.mjs",
