  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3"
  }
