# Frontend (Next.js marketing site + admin UI)
# API secrets live in artifacts/miyar-api/.env — not here.

# Optional: direct browser→API base. Leave empty to use same-origin /api
# (Next.js rewrites /api → API_INTERNAL_URL). Recommended for admin cookies.
NEXT_PUBLIC_API_URL=

# Server-side / rewrite target for miyar-api
API_INTERNAL_URL=http://127.0.0.1:4000

# Google reCAPTCHA v3 site key (public)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
