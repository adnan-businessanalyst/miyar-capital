# Frontend (Next.js marketing site + admin UI)
# API secrets live in artifacts/miyar-api/.env — not here.

APP_ENV=staging

# Optional: direct browser→API base. Leave empty to use same-origin /api
# (Next.js proxies /api → Railway / local API). Recommended for admin cookies.
NEXT_PUBLIC_API_URL=

# Local API (used on this machine)
API_INTERNAL_URL=http://127.0.0.1:4000

# Railway API origins. Hosted Vercel picks one from APP_ENV.
# Staging Railway (this GitHub repo). Production Railway (TheProvenX).
RAILWAY_URL_STAGING=https://your-staging.up.railway.app
RAILWAY_URL_PRODUCTION=https://your-production.up.railway.app

# Same random value as Railway API_PROXY_SECRET. Lets /api proxy send the
# visitor IP so rate limits are not keyed on Vercel’s egress address.
# Generate once; set on Vercel (Production + Preview) and matching Railway.
API_PROXY_SECRET=

# Google reCAPTCHA v3 site key — set on production Vercel (Production env).
# Must pair with Railway RECAPTCHA_SECRET_KEY from the same Google key.
# Domains in Google admin: miyar-capital.vercel.app (+ custom domains).
# Also set APP_ENV=production on that Vercel project.
RECAPTCHA_SITE_KEY=
