# Postgres (Neon-ready connection string)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Resend transactional email
# Create an API key at https://resend.com and verify your sending domain (SPF/DKIM).
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL="Miyar Capital <noreply@your-verified-domain.com>"
CONTACT_TO_EMAIL=inbox@your-company.com

# Google reCAPTCHA v3
# Site key is public (client). Secret must stay server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Admin control panel (/admin) — env password + signed httpOnly cookie session
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string
